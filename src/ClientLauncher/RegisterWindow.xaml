<Window x:Class="LocalExile.ClientTool.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="注册账号" Width="420" Height="380" WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{StaticResource Panel}" TextElement.Foreground="{StaticResource Text}"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13">
    <Border BorderBrush="{StaticResource Edge}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource Card}" MouseLeftButtonDown="CaptionDrag">
                <DockPanel Margin="16,0,6,0">
                    <Button DockPanel.Dock="Right" Content="✕" Style="{StaticResource Caption}" Click="CloseClicked" ToolTip="关闭" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="4" Height="16" Background="{StaticResource Accent}" CornerRadius="2" Margin="0,0,9,0" />
                        <TextBlock Text="注册账号" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <StackPanel Grid.Row="1" Margin="20,14,20,16">
                <TextBlock x:Name="TargetText" Text="…" Foreground="{StaticResource Muted}" FontSize="11.5" />

                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="账号" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBox x:Name="NameBox" Grid.Row="0" Grid.Column="1" Style="{StaticResource Field}" MaxLength="32"
                             KeyDown="NameKeyDown" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="密码" VerticalAlignment="Center" Margin="0,8,10,0" />
                    <PasswordBox x:Name="PassBox" Grid.Row="1" Grid.Column="1" Style="{StaticResource Secret}" MaxLength="64"
                                 Margin="0,8,0,0" KeyDown="PassKeyDown" />
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="确认密码" VerticalAlignment="Center" Margin="0,8,10,0" />
                    <PasswordBox x:Name="ConfirmBox" Grid.Row="2" Grid.Column="1" Style="{StaticResource Secret}" MaxLength="64"
                                 Margin="0,8,0,0" KeyDown="ConfirmKeyDown" />
                </Grid>

                <TextBlock Text="账号 3-32 位：字母、数字、_ 或 -；密码至少 4 位。账号存在服务器上，别用真实密码。"
                           Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0" />

                <TextBlock x:Name="StatusText" Text="" Foreground="{StaticResource Muted}" FontSize="12"
                           TextWrapping="Wrap" Margin="0,12,0,0" MinHeight="34" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                    <Button x:Name="CancelButton" Content="取消" Style="{StaticResource Quiet}" Padding="16,7" FontSize="12.5"
                            Click="CloseClicked" />
                    <Button x:Name="RegisterButton" Content="注册" Style="{StaticResource Action}" Padding="20,7" FontSize="12.5"
                            Margin="8,0,0,0" Click="RegisterClicked" IsDefault="True" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
