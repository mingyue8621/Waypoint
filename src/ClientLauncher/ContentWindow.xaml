<Window x:Class="LocalExile.ClientTool.ContentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="流放之路" Width="900" Height="660" MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="#0B0D12" TextElement.Foreground="{StaticResource Text}"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13">
    <Border BorderBrush="{StaticResource Edge}" BorderThickness="1" Background="{StaticResource Panel}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="56" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 标题栏：拖动移动，右边关闭 -->
            <Border Grid.Row="0" Background="#151821" BorderBrush="{StaticResource Edge}" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="CaptionDrag">
                <DockPanel Margin="20,0,10,0">
                    <Button DockPanel.Dock="Right" Content="✕" Style="{StaticResource Caption}" Click="CloseClicked" ToolTip="关闭" />
                    <TextBlock x:Name="HeadingText" Foreground="#F0DFB8" FontSize="16" FontWeight="SemiBold"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </Border>

            <ScrollViewer x:Name="Scroller" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Padding="24,18,24,20" Focusable="False">
                <StackPanel x:Name="Body" />
            </ScrollViewer>

            <Border Grid.Row="2" Background="#0F1218" BorderBrush="{StaticResource Edge}" BorderThickness="0,1,0,0" Padding="20,10">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="关闭" Style="{StaticResource Quiet}" Padding="24,7" Click="CloseClicked" />
                    <TextBlock x:Name="FootText" Foreground="{StaticResource Muted}" FontSize="11.5" VerticalAlignment="Center" />
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
