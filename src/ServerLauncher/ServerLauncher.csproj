<Project Sdk="Microsoft.NET.Sdk">

  <!-- 流放之路服务端.exe: Waypoint's sections on their own, for the servers. It reuses that assembly's sections,
       service monitor, settings and adapter (the ProjectReference below) and carries none of its install, setup or
       update screens; the client is 流放之路登录器.exe's job. The checkout is found by itself: no folder picker. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>流放之路服务端</AssemblyName>
    <RootNamespace>LocalExile.ServerTool</RootNamespace>
    <Version>0.0.0-dev</Version>
    <ApplicationIcon>..\..\branding\app.ico</ApplicationIcon>
    <SatelliteResourceLanguages>en;zh-CN</SatelliteResourceLanguages>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- Publish-Two.ps1 passes -p:SelfContained=true for this project, so the .exe carries its own .NET runtime: copy it
         to another Windows PC and it runs, with no .NET Desktop Runtime to install first. It cannot be set here alone —
         a self-contained executable may not reference the framework-dependent Waypoint.exe (NETSDK1150) — so the switch
         is a global property that makes the whole reference chain self-contained for this one publish. -->
    <SelfContained>false</SelfContained>
    <!-- One file, as Waypoint.exe is: the bundle unpacks Waypoint's resources for the XAML to find them. -->
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="..\..\branding\app.ico" Link="app.ico" />
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Launcher.Core\Launcher.Core.csproj" />
    <ProjectReference Include="..\Waypoint\Waypoint.csproj" />
  </ItemGroup>

</Project>
